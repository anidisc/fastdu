# fastdu Configuration Example
# Copy this file to ~/.config/fastdu/config.toml to apply changes.

# ---------------------------------------------------------
# THEME PRESETS
# ---------------------------------------------------------
# Choose one of the built-in color presets.
# Current theme name is displayed in the bottom-right corner (T:[theme]).
#
# Valid values: "dark" (default), "dracula", "tokyonight", "light", "pastel"
theme = "dracula"

# ---------------------------------------------------------
# CUSTOM COLOR OVERRIDES
# ---------------------------------------------------------
# If defined, these values will override the preset selected above.
#
# Available colors: "black", "red", "green", "yellow", 
#                   "blue", "magenta", "cyan", "white"

# Header and Footer bars
# header_fg = "white"
# header_bg = "blue"

# Accent color (UI separators, clickable breadcrumbs)
# accent_fg = "cyan"

# Item colors
# dir_fg = "blue"
# file_fg = "white"

# Size-based coloring (color changes based on item size)
# size_s_fg = "green"   # Small items
# size_m_fg = "yellow"  # Medium items (>10 MiB)
# size_l_fg = "red"     # Large items (>1 GiB)

# ---------------------------------------------------------
# EXTERNAL EDITOR
# ---------------------------------------------------------
# Specify your preferred editor for Ctrl+E shortcut.
# If not set, fastdu will use $EDITOR or a system default (vim/nano).
#
# editor = "nvim"

# ---------------------------------------------------------
# FILE ASSOCIATIONS (Open with Ctrl+O)
# ---------------------------------------------------------
# Map file extensions to specific commands.
# If an extension is not defined here, fastdu will use the system's
# default handler (xdg-open on Linux, open on macOS).
#
# Format: [associations]
#         ext = "command"

[associations]
# pdf = "zathura"
# png = "sxiv"
# jpg = "sxiv"
# mp4 = "mpv"

# ---------------------------------------------------------
# PARSER NOTES
# ---------------------------------------------------------
# 1. Lines starting with # are comments.
# 2. Section headers like [associations] are required for mapping.
# 3. Use spaces around the equal sign (e.g., key = value).
# 4. Double quotes around string values are optional but recommended.
# 5. Case-insensitive color names and theme names.
